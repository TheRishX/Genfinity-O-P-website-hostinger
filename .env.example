# Hostinger Node.js runtime
NODE_ENV="production"
APP_URL="https://your-domain.example"
HOSTINGER_PHI_APPROVED="false"
HOSTINGER_STORAGE_PATH="/home/USER/private/genfinity-storage"

# Hostinger MySQL (server-only)
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_DATABASE="genfinity"
MYSQL_USER="genfinity_user"
MYSQL_PASSWORD="replace-with-hostinger-secret"
MYSQL_SSL="false"
MYSQL_CONNECTION_LIMIT="10"

# AI and Brevo SMTP
GEMINI_API_KEY="replace-with-gemini-key"
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_LOGIN="your-login@smtp-brevo.com"
BREVO_SMTP_KEY="your-smtp-key"
BREVO_SENDER_NAME="Genfinity O&P"
BREVO_SENDER_EMAIL="notifications@genfinityoandp.com"
CONTACT_TO_EMAIL="support@genfinityoandp.com"
CARE_EMAILS_ENABLED="false"
INTAKE_SEND_EMAILS="false"

# Existing application encryption keys. Never rotate without re-encryption.
INTAKE_ENCRYPTION_KEY="base64_32_byte_key"
INTAKE_SEARCH_KEY="different_base64_32_byte_key"
PATIENT_INTAKE_MODE="staging"
OWNER_EMAIL="owner@genfinityoandp.com"
NEXT_PUBLIC_OWNER_EMAIL="owner@genfinityoandp.com"
AUTH_SESSION_SECRET="replace-with-a-long-random-secret"
NPP_VERSION="pending-official-notice"
NEXT_PUBLIC_NPP_URL="/privacy"

# WordPress blog source
WORDPRESS_BLOG_URL="https://blog.genfinityoandp.com"

# One-time migration source only; never configure these in Hostinger runtime.
# SUPABASE_PROJECT_REF="xpeyatekdkwlfaoflczl"
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SECRET_KEY="migration-only-secret"
