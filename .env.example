# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Outstatic stores blog Markdown/MDX in GitHub. No database is required.
# Use either your own GitHub App/OAuth app, or an Outstatic Pro API key.
OST_GITHUB_ID="your-github-app-client-id"
OST_GITHUB_SECRET="your-github-app-client-secret"
OST_REPO_OWNER="your-github-username-or-organization"
OST_REPO_SLUG="your-github-repository-name"
OST_REPO_BRANCH="main"
OST_CONTENT_PATH="outstatic/content"
# Generate a random value of at least 32 characters.
OST_TOKEN_SECRET="replace-with-a-long-random-secret"

# Brevo transactional SMTP delivery (server-side only).
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_LOGIN="your-login@smtp-brevo.com"
BREVO_SMTP_KEY="your-smtp-key"
BREVO_SENDER_NAME="Genfinity O&P"
BREVO_SENDER_EMAIL="notifications@genfinityoandp.com"
CONTACT_TO_EMAIL="support@genfinityoandp.com"
# Keep false until your healthcare privacy/compliance review is complete and
# the SMTP provider is approved for patient communication.
CARE_EMAILS_ENABLED="false"

# Supabase-backed new patient intake. This system accepts real patients only,
# and remains locked until every live prerequisite below is complete.
# Never place the secret key or encryption keys in NEXT_PUBLIC variables.
PATIENT_INTAKE_MODE="live"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_sb_publishable_key"
SUPABASE_SECRET_KEY="your_server_only_sb_secret_key"
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.
OWNER_EMAIL="owner@genfinityoandp.com"
NEXT_PUBLIC_OWNER_EMAIL="owner@genfinityoandp.com"

# Generate each with: openssl rand -base64 32
INTAKE_ENCRYPTION_KEY="base64_32_byte_key"
INTAKE_SEARCH_KEY="different_base64_32_byte_key"

# Real-patient submission remains locked unless these are present.
SUPABASE_HIPAA_READY="false"
NPP_VERSION="pending-official-notice"
NEXT_PUBLIC_NPP_URL="/privacy"
INTAKE_SEND_EMAILS="false"
